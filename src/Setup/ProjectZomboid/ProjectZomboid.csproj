<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>$(AssemblyName)</Title>
		<Version>1.0.0</Version>
		<Company>$(GlobalCompany)</Company>
		<Copyright>$(GlobalCopyright)</Copyright>
		<Authors>$(GlobalAuthors)</Authors>
		<AssemblyName>GameHost.Games.ProjectZomboid.Console</AssemblyName>
		<RootNamespace>GameHost.Games.ProjectZomboid.Console</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="GameHost.Keys" />
		<PackageReference Include="LunaticPanel.Core.Utils"  />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Library\Installation\Installation.csproj" />
	  <ProjectReference Include="..\..\Library\LinuxGameServerManager.Extension\LinuxGameServerManager.Extension.csproj" />
	  <ProjectReference Include="..\..\Library\LinuxGameServerManager\LinuxGameServerManager.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="assets\**\*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="config\**\*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <Content Include="config\game_info.json" />
	</ItemGroup>


</Project>